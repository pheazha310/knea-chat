{
  "name": "kneachat-backend",
  "version": "1.0.0",
  "description": "KneaChat - Workplace Communication & Collaboration Platform Backend",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "start": "node dist/src/server.js",
    "dev": "tsc && (tsc -w & nodemon --watch dist dist/src/server.js)",
    "daemon": "python3 scripts/kneachat-daemon.py start",
    "daemon:stop": "python3 scripts/kneachat-daemon.py stop",
    "daemon:status": "python3 scripts/kneachat-daemon.py status",
    "daemon:restart": "python3 scripts/kneachat-daemon.py restart",
    "db:init": "node scripts/init-db.js",
    "db:seed": "node scripts/seed.js",
    "import:company": "node scripts/import-company.js",
    "db:setup": "npm run db:init && npm run db:seed",
    "seed:demo": "node scripts/create-demo-user.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:e2e": "node e2e/notifications.e2e.js",
    "test:e2e:avatar": "node e2e/avatar-upload.e2e.js",
    "test:e2e:permissions": "node e2e/permissions.e2e.js",
    "test:e2e:attendance": "node e2e/attendance.e2e.js",
    "test:e2e:files": "node e2e/shared-files.e2e.js",
    "test:e2e:tasks": "node e2e/tasks-notifications.e2e.js",
    "test:e2e:sessions": "node e2e/sessions.e2e.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "kneachat",
    "communication",
    "collaboration",
    "websocket",
    "real-time"
  ],
  "author": "KneaChat Team",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "redis": "^4.7.1",
    "uuid": "^14.0.1",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^8.52.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "typescript": "^7.0.2"
  }
}
