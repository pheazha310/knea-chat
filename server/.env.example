# KneaChat Backend - Environment Variables
# Copy this file to .env and fill in your actual values
#   cp .env.example .env

# Server Configuration
PORT=8080
HOST=localhost
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kneachat

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=24h

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Email Configuration (app emails: password reset, notifications)
# Gmail: enable 2-Step Verification, then create an App Password at:
#   https://myaccount.google.com/apppasswords
# Use that 16-char app password in EMAIL_PASSWORD / EMAIL_SMTP_PASS below.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
# FROM address must match the Gmail account or an allowed alias.
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=KneaChat

# Email SMTP Configuration (for omni-channel outbound agent replies)
# Option A — Gmail (needs an App Password, not your login password):
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASS=your-app-password
EMAIL_SMTP_SECURE=false
# Option B — Resend SMTP relay (no app passwords; sends from your Resend domain):
#   EMAIL_SMTP_HOST=smtp.resend.com
#   EMAIL_SMTP_PORT=465
#   EMAIL_SMTP_SECURE=true
#   EMAIL_SMTP_USER=resend
#   EMAIL_SMTP_PASS=re_...   (any Resend API key with send access)
#   EMAIL_FROM=support@kneachat.com  (a domain verified in Resend)

# Email Webhook Configuration (for omni-channel inbound)
# Incoming provider webhooks are ignored unless this is explicitly true. Keep
# it false when you only need outbound email and do not want email messages in
# the Omni Inbox.
EMAIL_INBOUND_ENABLED=false
EMAIL_WEBHOOK_SECRET=
EMAIL_WEBHOOK_URL=https://your-domain.com/api/email/webhook
# The public domain that receives customer email (MX records must point at
# your email provider). Used only by the startup diagnostics that warn when
# inbound routing is broken. Set EMAIL_STARTUP_CHECKS=false to disable.
EMAIL_INBOUND_DOMAIN=kneachat.com
EMAIL_STARTUP_CHECKS=true
# Optional: RSA/ECDSA public key (PEM) for providers that sign webhook
# payloads with a key pair (SendGrid Event Webhook, Postmark). Use \n for
# newlines. When set, the email webhook verifies the provider signature
# cryptographically instead of falling back to the shared HMAC secret.
EMAIL_WEBHOOK_PUBLIC_KEY=

# Resend (inbound receiving + Svix webhook signing) — provisioned by:
#   npm run resend:setup -- <management-key> https://<host>/api/email/webhook
# RESEND_MANAGEMENT_API_KEY is only used by the setup script; the server uses
# EMAIL_RESEND_API_KEY. Run the script once, or fill these in by hand.
RESEND_MANAGEMENT_API_KEY=
EMAIL_RESEND_WEBHOOK_SECRET=
EMAIL_RESEND_API_KEY=
# Optional override for the Resend API base URL (local simulation / proxy).
EMAIL_RESEND_API_BASE=https://api.resend.com

# Telegram Bot Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=info

# Redis (Optional - for sessions, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Telegram Bot Configuration
# Create a bot with BotFather (https://t.me/BotFather) and paste its token.
# The token is a secret — never commit it or expose it to the frontend.
TELEGRAM_BOT_TOKEN=
# Telegram Bot API base URL (https must be reachable from the server).
TELEGRAM_API_URL=https://api.telegram.org
# Secret token Telegram sends back with every webhook delivery
# (X-Telegram-Bot-Api-Secret-Token). Always set this in production.
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL Telegram delivers updates to (e.g. https://<domain>/api/telegram/webhook).
# Used as the default by POST /api/telegram/setup-webhook; set it via ngrok for local testing.
TELEGRAM_WEBHOOK_URL=
# Optional: comma-separated KneaChat user ids that see the omni inbox.
# Leave empty to auto-join every internal user. (TELEGRAM_INBOX_AGENT_IDS is
# kept as a legacy alias.)
OMNI_INBOX_AGENT_IDS=
TELEGRAM_INBOX_AGENT_IDS=
